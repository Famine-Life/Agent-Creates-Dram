# ============================================================================
# aigc.service — systemd 服务文件
#
# 复制到服务器: cp aigc.service /etc/systemd/system/
# 常用命令：
#   systemctl daemon-reload
#   systemctl enable --now aigc     # 开机自启 + 立即启动
#   systemctl status aigc           # 查看状态
#   journalctl -u aigc -f           # 实时日志
#   systemctl restart aigc          # 重启
#   systemctl stop aigc             # 停机
# ============================================================================

[Unit]
Description=AIGC Video Canvas Backend
After=network.target mysqld.service redis.service
# 如果没装 Redis，把 redis.service 删掉
# 如果没装 MySQL（用本地文件库 H2），把 mysqld.service 删掉

[Service]
Type=simple
User=root
# 后端 jar 所在目录
WorkingDirectory=/opt/aigc

# ================= 启动命令 =================
# 常用 profile：
#   local    → 本地 MySQL/Redis，启动自动跑 schema
#   mysql    → 远程 MySQL，需单独执行 schema
# 存储类型：
#   local    → 本地磁盘 ./data/files（最简单，单节点首选）
#   minio    → MinIO 对象存储
#   cos      → 腾讯云 COS
#   oss      → 阿里云 OSS
# =================
ExecStart=/usr/local/jdk17/bin/java \
  -Xms512m \
  -Xmx2048m \
  -XX:+UseG1GC \
  -XX:MaxGCPauseMillis=200 \
  -jar /opt/aigc/aigc-video-server-0.1.0.jar \
  --server.port=9900 \
  --spring.profiles.active=local \
  --AIGC_STORAGE_TYPE=local \
  --AIGC_COOKIE_SECURE=false \
  --logging.file.path=/var/log/aigc \
  --logging.file.name=/var/log/aigc/app.log

# 崩溃自动拉起
Restart=on-failure
RestartSec=5

# 优雅停机（给 AI 视频任务足够时间转存完成）
TimeoutStopSec=60
KillMode=mixed

# ================= 环境变量 =================
# 敏感配置通过环境变量注入，不要硬编码到 yml
# 公网部署请务必修改默认值！
# 本文件含密钥时建议 chmod 600 /etc/systemd/system/aigc.service
Environment=JAVA_HOME=/usr/local/jdk17
Environment=AIGC_ADMIN_USERNAME=admin
Environment=AIGC_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
Environment=MCP_API_TOKEN=CHANGE_ME_RANDOM_UUID
# 远程 MySQL（如果用 local profile 连接远程库，取消注释）
# Environment=MYSQL_USER=root
# Environment=MYSQL_PASSWORD=your_mysql_password
# Redis（多实例部署才需要开）
# Environment=AIGC_SESSION_REDIS_ENABLED=false
# Environment=AIGC_REDIS_ENABLED=false
# 火山方舟 API Key
Environment=ARK_API_KEY=your_ark_api_key_here
# 腾讯云 COS（type=cos 时必填，直接填在 Environment 里）
# Environment=COS_ENDPOINT=https://cyww-1309785294.cos.ap-guangzhou.myqcloud.com
# Environment=COS_SECRET_ID=your_cos_secret_id
# Environment=COS_SECRET_KEY=your_cos_secret_key
# Environment=COS_BUCKET=cyww-1309785294
# Environment=COS_REGION=ap-guangzhou
# Environment=COS_PUBLIC_URL=https://cos.xrtk.top

[Install]
WantedBy=multi-user.target
